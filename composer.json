{
  "name": "mr2p/breadcrumb-block",
  "type": "wordpress-plugin",
  "description": "The bootstrap for the next WordPress plugin.",
  "keywords": [
    "WordPress",
    "Plugins",
    "Breadcrumb",
    "Block"
  ],
  "homepage": "https://github.com/mr2p/breadcrumb-block",
  "license": "GPL-2.0-or-later",
  "authors": [],
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
    "php-parallel-lint/php-parallel-lint": "^1.3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "3.4.1",
    "phpunit/phpunit": "^9.6.33",
    "brain/monkey": "^2.6"
  },
  "scripts": {
    "lint:wpcs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
    "lint:php": "@php ./vendor/bin/parallel-lint --exclude .git --exclude vendor --exclude node_modules --exclude wpcs --exclude build .",
    "test:php": "@php ./vendor/bin/phpunit --no-coverage"
  },
  "autoload-dev": {
    "psr-4": {
      "BreadcrumbBlock\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "support": {
    "issues": "https://github.com/mr2p/breadcrumb-block/issues",
    "source": "https://github.com/mr2p/breadcrumb-block"
  }
}
