{
  "name": "breadcrumb-block",
  "version": "1.2.0",
  "description": "A simple breadcrumb trail block that supports JSON-LD structured data",
  "author": "Phi Phan",
  "license": "GPL-2.0-or-later",
  "main": "build/index.js",
  "scripts": {
    "bump:patch": "node scripts/bump-version.js --type=patch",
    "bump:minor": "node scripts/bump-version.js --type=minor",
    "bump:major": "node scripts/bump-version.js --type=major",
    "git-tag": "node scripts/git-tag.js",
    "build": "wp-scripts build",
    "format": "wp-scripts format",
    "lint": "yarn lint:js && yarn lint:css && composer lint:php && composer lint:wpcs",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "start": "wp-scripts start",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "test": "yarn test:js && yarn test:php",
    "test:js": "wp-scripts test-unit-js --passWithNoTests",
    "test:php": "composer test:php",
    "test:e2e": "playwright test",
    "test:e2e:gifs": "node e2e/make-gifs.mjs",
    "e2e:proofs": "yarn test:e2e && yarn test:e2e:gifs",
    "verify": "yarn lint && yarn test && yarn build",
    "make-pot": "wp i18n make-pot . languages/breadcrumb-block.pot"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@wordpress/block-editor": "^20.1.0",
    "@wordpress/blocks": "^17.2.0",
    "@wordpress/components": "^45.0.0",
    "@wordpress/core-data": "^9.2.0",
    "@wordpress/data": "^11.2.0",
    "@wordpress/editor": "^16.2.0",
    "@wordpress/element": "^10.2.0",
    "@wordpress/i18n": "^7.2.0",
    "@wordpress/plugins": "^8.2.0",
    "@wordpress/scripts": "^37.2.0",
    "gifenc": "^1.0.3",
    "globby": "^11.1.0",
    "pngjs": "^7.0.0",
    "semver": "^6.3.0",
    "vite": "8",
    "vitest": "5"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
